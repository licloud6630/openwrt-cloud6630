. /lib/functions.sh
. /lib/upgrade/common.sh

device_set_overlayfs_part(){
	uci set system.@system[0].compat_version="2.0"
	uci commit
	
	if [ -e "/dev/mmcblk0p3" ]; then
		return 1
	fi

	if [ ! -e "/dev/mmcblk0p1" ] && [ ! -e "/dev/mmcblk0p2" ]; then
		return 1
	fi

	local part2end=$(fdisk -l $tar_file | grep $tar_file"p2" | awk '{print substr($3, index($2, $3))}')
	local part3start=$(expr $part2end + 15360)
	echo "start part...."
	echo -ne "n\np\n3\n$part3start\n\nw\n" | fdisk /dev/mmcblk0
	sleep 3
	reboot
}

overlayfs_init() {
	local board=$(cat /tmp/sysinfo/board_name)

	case "$board" in
	fsl,ls1012a-ag101a | \
	fsl,ls1043a-ag1002at | \
	fsl,ls1043a-ag1002a | \
	fsl,ls1043a-ag104a | \
	fsl,ls1043a-future03)
		device_set_overlayfs_part
		;;
	esac
}

boot_hook_add preinit_mount_root overlayfs_init
