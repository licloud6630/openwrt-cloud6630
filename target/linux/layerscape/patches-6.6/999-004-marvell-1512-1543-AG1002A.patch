---
 drivers/net/phy/marvell.c | 118 ++++++++++++++++++++++++++++++++++++++
 1 file changed, 118 insertions(+)

diff --git a/drivers/net/phy/marvell.c b/drivers/net/phy/marvell.c
index eba652a..96892fc 100644
--- a/drivers/net/phy/marvell.c
+++ b/drivers/net/phy/marvell.c
@@ -38,6 +38,13 @@
 #include <asm/irq.h>
 #include <linux/uaccess.h>
 
+#define MARVELL_PHY_ID_88E1512		0x01410dd1
+#define MARVELL_PHY_ID_88E1512P		0x01410dd4
+#define MARVELL_PHY_ID_88E1543		0x01410ea2
+
+#define MII_88E1121_PHY_LED_1512_DEF	0x1817
+#define MII_88E1121_PHY_LED_1543_DEF	0x1717
+
 #define MII_MARVELL_PHY_PAGE		22
 #define MII_MARVELL_COPPER_PAGE		0x00
 #define MII_MARVELL_FIBER_PAGE		0x01
@@ -288,6 +295,11 @@ MODULE_DESCRIPTION("Marvell PHY driver");
 MODULE_AUTHOR("Andy Fleming");
 MODULE_LICENSE("GPL");
 
+int fiber_led_flag_c = 0;
+int fiber_led_flag_d = 0;
+int copper_led_flag_c = 0;
+int copper_led_flag_d = 0;
+
 struct marvell_hw_stat {
 	const char *string;
 	u8 page;
@@ -312,6 +324,11 @@ struct marvell_priv {
 	s8 pair;
 };
 
+static int marvell_get_page(struct phy_device *phydev)
+{
+	return phy_read(phydev, MII_MARVELL_PHY_PAGE);
+}
+
 static int marvell_read_page(struct phy_device *phydev)
 {
 	return __phy_read(phydev, MII_MARVELL_PHY_PAGE);
@@ -547,6 +564,9 @@ static int m88e1121_config_aneg_rgmii_delays(struct phy_device *phydev)
 {
 	int mscr;
 
+	if(phydev->phy_id == MARVELL_PHY_ID_88E1512 || phydev->phy_id == MARVELL_PHY_ID_88E1512P)
+		phydev->interface = PHY_INTERFACE_MODE_RGMII_ID;
+
 	if (phydev->interface == PHY_INTERFACE_MODE_RGMII_ID)
 		mscr = MII_88E1121_PHY_MSCR_RX_DELAY |
 		       MII_88E1121_PHY_MSCR_TX_DELAY;
@@ -790,6 +810,20 @@ static int marvell_config_init(struct phy_device *phydev)
 {
 	/* Set default LED */
 	marvell_config_led(phydev);
+	if(phydev->phy_id == MARVELL_PHY_ID_88E1543)
+	{
+		int oldpage;
+		
+		marvell_set_page(phydev, MII_MARVELL_LED_PAGE);
+		phy_write(phydev, MII_PHY_LED_CTRL, MII_88E1121_PHY_LED_1512_DEF);
+
+		/*modify sgmii vod*/		
+		oldpage = marvell_get_page(phydev);
+		marvell_set_page(phydev, 1);
+		phy_write(phydev, 0x1a, 0x44);
+
+		marvell_set_page(phydev, oldpage);
+	}
 
 	/* Set registers from marvell,reg-init DT property */
 	return marvell_of_reg_init(phydev);
@@ -1681,6 +1715,90 @@ static int marvell_read_status_page(struct phy_device *phydev, int page)
 	else
 		err = genphy_read_status_fixed(phydev);
 
+	if(phydev->phy_id == MARVELL_PHY_ID_88E1512)
+	{
+		/*add by liji to change led */	
+		if(phydev->mdio.bus->id[14] == 'd')
+		{
+			if((fiber == 1) && (phydev->link == 0) && (fiber_led_flag_d != 0))
+			{	
+				fiber_led_flag_d = 0;		
+			
+				marvell_set_page(phydev, 3);
+				phy_write(phydev, 0x10, 0x1888);
+				marvell_set_page(phydev, page);
+			}
+			if((fiber == 0) && (phydev->link == 0) && (copper_led_flag_d != 0))
+			{		
+				copper_led_flag_d = 0;
+				
+				marvell_set_page(phydev, 3);
+				phy_write(phydev, 0x10, 0x1888);
+				marvell_set_page(phydev, page);
+			}
+			if(fiber == 1 && phydev->link == 1 && (fiber_led_flag_d == 0))
+			{		
+				/*开光灯，关电灯*/
+				marvell_set_page(phydev, 3);
+				phy_write(phydev, 0x10, 0x1188);
+				marvell_set_page(phydev, 1);
+				fiber_led_flag_d = 1;
+				copper_led_flag_d = 0;
+				//phy_write(phydev, 0, 0x9140);			
+			}
+			if(fiber == 0 && phydev->link == 1 && (copper_led_flag_d == 0))
+			{
+				/*开电灯，关光灯*/
+				marvell_set_page(phydev, 3);
+				phy_write(phydev, 0x10, 0x1817);
+				marvell_set_page(phydev, 0);
+				fiber_led_flag_d = 0;
+				copper_led_flag_d = 1;
+				//phy_write(phydev, 0, 0x9140);			
+			}
+		}
+
+		if(phydev->mdio.bus->id[14] == 'c')
+		{
+			if((fiber == 1) && (phydev->link == 0) && (fiber_led_flag_c != 0))
+			{		
+				fiber_led_flag_c = 0;
+				
+				marvell_set_page(phydev, 3);
+				phy_write(phydev, 0x10, 0x1888);
+				marvell_set_page(phydev, page);
+			}
+			if((fiber == 0) && (phydev->link == 0) && (copper_led_flag_c != 0))
+			{
+				copper_led_flag_c = 0;
+				
+				marvell_set_page(phydev, 3);
+				phy_write(phydev, 0x10, 0x1888);
+				marvell_set_page(phydev, page);
+			}
+			if(fiber == 1 && phydev->link == 1 && (fiber_led_flag_c == 0))
+			{		
+				/*开光灯，关电灯*/
+				marvell_set_page(phydev, 3);
+				phy_write(phydev, 0x10, 0x1188);
+				marvell_set_page(phydev, 1);
+				fiber_led_flag_c = 1;
+				copper_led_flag_c = 0;
+				//phy_write(phydev, 0, 0x9140);
+			}
+			if(fiber == 0 && phydev->link == 1 && (copper_led_flag_c == 0))
+			{
+				/*开电灯，关光灯*/
+				marvell_set_page(phydev, 3);
+				phy_write(phydev, 0x10, 0x1817);
+				marvell_set_page(phydev, 0);
+				fiber_led_flag_c = 0;
+				copper_led_flag_c = 1;	
+				//phy_write(phydev, 0, 0x9140);
+			}
+		}
+	}
+
 	return err;
 }
 
