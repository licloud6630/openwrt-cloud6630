From 055d58af65a52fd99320ac19d23718a6240240b2 Mon Sep 17 00:00:00 2001
From: liji <liji6630@foxmail.com>
Date: Mon, 3 Nov 2025 16:14:25 +0800
Subject: [PATCH] blink mt7531 led0 led1 when config init

---
 drivers/net/phy/mediatek/mtk-ge.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/drivers/net/phy/mediatek/mtk-ge.c b/drivers/net/phy/mediatek/mtk-ge.c
index b11e025..7f146cc 100644
--- a/drivers/net/phy/mediatek/mtk-ge.c
+++ b/drivers/net/phy/mediatek/mtk-ge.c
@@ -166,6 +166,14 @@ static void mt7531_phy_line_driving(struct phy_device *phydev)
 	 * increase current.
 	 */
 	phy_write_mmd(phydev, MDIO_MMD_VEND2, 0x26a, 0x3333);
+
+	/* blink led0 led1*/
+	phy_write_mmd(phydev, MDIO_MMD_VEND2, 0x21, 0x8009);
+    phy_write_mmd(phydev, MDIO_MMD_VEND2, 0x24, 0xc007);
+    phy_write_mmd(phydev, MDIO_MMD_VEND2, 0x25, 0x0);
+    phy_write_mmd(phydev, MDIO_MMD_VEND2, 0x21, 0x8009);
+    phy_write_mmd(phydev, MDIO_MMD_VEND2, 0x26, 0xc007);
+    phy_write_mmd(phydev, MDIO_MMD_VEND2, 0x27, 0x3);
 }
 
 static void mt7531_phy_eee(struct phy_device *phydev)
-- 
2.25.1

